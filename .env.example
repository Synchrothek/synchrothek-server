# Kopieren nach .env und anpassen (wird von docker compose automatisch gelesen).

# --- compose.caddy.yaml ---------------------------------------------------
# Domain, unter der der Server erreichbar sein soll (DNS muss auf diesen Host zeigen)
DOMAIN=sync.example.org

# --- compose.yaml ---------------------------------------------------------
# 127.0.0.1 = nur lokal erreichbar (wenn ein Reverse Proxy auf dem Host davorsteht)
# SYNCHROTHEK_BIND=0.0.0.0
# SYNCHROTHEK_PORT=8080
# Auf true setzen, wenn ein Reverse Proxy davorsteht und der Port nur lokal gebunden ist
# TRUST_PROXY=false

# --- compose.proxy.yaml (zusätzlich zu compose.yaml) ------------------------
# Reverse Proxy läuft selbst als Docker-Container: kein Host-Port, Zugriff über dessen Netzwerk
# COMPOSE_FILE=compose.yaml:compose.proxy.yaml
# PROXY_NETWORK=proxy

# --- Beide ----------------------------------------------------------------
# Eigenes oder anderes Image verwenden
# SYNCHROTHEK_IMAGE=ghcr.io/synchrothek/synchrothek-server:latest
# Max. gleichzeitige Verbindungen pro IP-Adresse (0 = unbegrenzt)
# MAX_CONNECTIONS_PER_IP=20
# Max. Teilnehmer pro Raum; Hosts können niedrigere Werte setzen (0 = unbegrenzt)
# MAX_ROOM_MEMBERS=20
# Max. Lebensdauer eines Raums in Minuten (0 = unbegrenzt)
# MAX_ROOM_DURATION_MINUTES=0
# Pausierte Räume ohne Aktivität nach X Minuten schließen (0 = nie)
# IDLE_ROOM_TIMEOUT_MINUTES=30
# Wie lange ein leerer Raum erhalten bleibt (Sekunden)
# EMPTY_ROOM_TTL_SECONDS=300
# Wie lange ein Mitglied nach Verbindungsabbruch seinen Platz (und ggf. die Host-Rolle) behält (Sekunden)
# RECONNECT_GRACE_SECONDS=30
# Erlaubte Origins, kommagetrennt, * als Platzhalter (leer = alle)
# ALLOWED_ORIGINS=chrome-extension://<extension-id>,moz-extension://*
